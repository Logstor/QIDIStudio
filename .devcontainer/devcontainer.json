{
  "name": "QIDIStudio (Debian)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "USERNAME": "qidi"
    }
  },
  "remoteUser": "qidi",
  "updateRemoteUserUID": true,
  "overrideCommand": true,
  "containerEnv": {
    "QDT_RELEASE_TO_PUBLIC": "0",
    "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
    "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"
  },
  "customizations": {
    "zed": {}
  }
}
